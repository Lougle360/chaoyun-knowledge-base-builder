---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { projectCases } from '../data/projects';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const featuredProjects = projectCases.filter((item) => item.featured).slice(0, 2);

function formatDate(date: Date) {
  return date.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<BaseLayout title="超云的Ai之旅">
  <section class="hero wrap">
    <div class="hero-visual" aria-hidden="true">
      <div class="orbit"></div>
    </div>
    <div class="hero-copy">
      <h1 class="hero-brand">超云的<em>Ai</em>之旅</h1>
      <p class="hero-lead">
        一个真实做 AI 项目的开发者，用 Cursor、Codex 等工具把想法落地，并能帮你落地。
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/projects">看作品</a>
        <a class="btn btn-ghost" href="/contact">找我合作</a>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2>精选项目</h2>
      <p>用案例说明能解决什么问题。首批真实案例待补充，当前为结构占位。</p>
    </div>
    <ul class="case-grid compact">
      {
        featuredProjects.map((item) => (
          <li class="case-card">
            <div class="case-top">
              <p class="case-industry">{item.industry}</p>
              {item.placeholder ? <span class="badge">占位</span> : null}
            </div>
            <h3>{item.title}</h3>
            <p class="case-brief">{item.problem}</p>
            <a class="text-link" href="/projects">查看全部案例 →</a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2>最新文章</h2>
      <p>AI 开发与应用的实战、方法和工作流。</p>
    </div>
    <ul class="post-list">
      {
        posts.map((post) => (
          <li>
            <a class="post-item" href={`/blog/${post.id}/`}>
              <div class="post-meta">
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                {post.data.tags.slice(0, 2).map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="cta-line">
      <a class="text-link" href="/blog">浏览全部文章 →</a>
    </p>
  </section>

  <section class="section wrap coop-band">
    <div class="section-head">
      <h2>需要把 AI 落到业务里？</h2>
      <p>FDE 式协作：从方案到可运行交付。价格按需报价，联系方式确认后公布。</p>
    </div>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/fde">了解 FDE 服务</a>
      <a class="btn btn-ghost" href="/contact">提交需求</a>
    </div>
  </section>
</BaseLayout>
