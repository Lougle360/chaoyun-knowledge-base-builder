---
import BaseLayout from '../layouts/BaseLayout.astro';

const scopes = [
  {
    title: 'AI 应用 MVP 开发',
    body: '从想法到可用产品：快速验证、迭代演示、交付可继续演进的代码与文档。',
  },
  {
    title: '企业内部 AI 工具',
    body: '知识库问答、文档处理、流程自动化等——贴合现有组织流程，而不是空壳 Demo。',
  },
  {
    title: '现有系统接入 AI',
    body: '在已有业务系统里加入大模型能力：接口、权限、数据边界与上线路径一起设计。',
  },
  {
    title: 'AI 开发工作流咨询与培训',
    body: '帮团队真正用好 Cursor / Codex：提示词、拆任务、评审与落地节奏。',
  },
];

const modes = [
  '按项目报价（适合需求相对明确）',
  '按周期驻场 / 远程驻场（适合长期迭代）',
  '咨询 / 培训按次收费',
];

const steps = ['需求沟通', '方案与报价', '签约', '迭代开发（定期演示）', '交付与培训', '售后维护'];

const faqs = [
  {
    q: '适合什么样的客户？',
    a: '企业决策者、技术负责人，以及想快速做出 AI 工具 / MVP 的个人与创业者。',
  },
  {
    q: '价格怎么算？',
    a: '目前统一按需报价。是否公开价格区间仍待确认，本页不会展示虚构数字。',
  },
  {
    q: '可以驻场吗？',
    a: '合作方式含驻场 / 远程驻场选项；具体城市与可驻场时段待关于页确认后补充。',
  },
];
---

<BaseLayout
  title="FDE 服务"
  description="超云的Ai之旅 FDE 服务：AI 应用落地、企业内部工具、系统接入与工作流培训。"
>
  <section class="page-hero wrap">
    <h1>FDE 服务</h1>
    <p>
      Forward Deployed Engineer：驻场 / 前置部署工程师式协作——不只给方案，更把 AI
      能力落到你的业务与代码里。
    </p>
    <div class="hero-actions" style="margin-top: 1.5rem;">
      <a class="btn btn-primary" href="/contact">提交需求</a>
      <a class="btn btn-ghost" href="/projects">先看案例</a>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2>服务范围</h2>
      <p>初稿范围，可按你的业务再裁剪。</p>
    </div>
    <ul class="service-grid">
      {
        scopes.map((item) => (
          <li class="service-block">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2>合作方式</h2>
      <p>按项目清晰度与协作强度选择。</p>
    </div>
    <ul class="plain-list">
      {modes.map((mode) => <li>{mode}</li>)}
    </ul>
    <p class="muted-note">价格说明：统一「按需报价」。是否公开区间见需求文档第 9 节，确认前不写具体数字。</p>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2>交付流程</h2>
      <p>从沟通到售后，节奏可预期。</p>
    </div>
    <ol class="flow-list">
      {steps.map((step) => <li>{step}</li>)}
    </ol>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2>常见问题</h2>
    </div>
    <div class="faq-list">
      {
        faqs.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</BaseLayout>
